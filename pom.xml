<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>de.wwsstl</groupId>
    <artifactId>asynchrone-anwendungsarchitektur</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>asynchrone-anwendungsarchitektur</name>
    <description>Asynchrone Testdaten-Pipeline (Producer/Consumer/Status-Pool je Sandbox)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Hauptklasse des JARs; der Hauptcode enthaelt mit FakeCloudBackendApplication eine zweite main-Methode -->
        <start-class>de.wwsstl.asynchrone.TestdatenPipelineApplication</start-class>
    </properties>

    <dependencies>
        <!-- Spring WebFlux (Netty): reaktive REST-Steuerungs-API (Start / Status / Abbruch, funktionsweise_sequenz.md)
             und WebClient fuer den nicht-blockierenden Cloud-Client -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!-- WebClient-Autokonfiguration (WebClient.Builder): In Spring Boot 4 ein eigenes Modul, das
             spring-boot-starter-webflux nicht mitbringt. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webclient</artifactId>
        </dependency>

        <!-- Jackson 3 (tools.jackson) ueber die Spring-Boot-4-Abhaengigkeitsverwaltung -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- Eigenstaendiges Fake-Backend fuer Integrationstests: mvn spring-boot:run@fake-backend -->
                    <execution>
                        <id>fake-backend</id>
                        <phase>none</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <mainClass>de.wwsstl.asynchrone.fakecloud.FakeCloudBackendApplication</mainClass>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Black-Box-Integrationstests (*IT) mit mvn verify: Anwendung (JAR) und FakeCloudBackendApplication als
                 eigene Prozesse -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <pipeline.it.app-jar>${project.build.directory}/${project.build.finalName}.jar</pipeline.it.app-jar>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
