    %% Anwendungsarchitektur mit Benutzer A und B (vereinfacht), Stand funktionsweise_sequenz.md

    UserA(["Benutzer A"])
    UserB(["Benutzer B"])

    API["REST-API<br/>Start / Abbruch / Status"]
    TM["TaskManager<br/>je Benutzer eine Sandbox,<br/>Start nur bei leerer pendingbox"]
    Reg[("TaskRegistry<br/>laufende Tasks, lokaler Stand")]

    SA["Sandbox Task A<br/>Producer · Status-Pool · Consumer"]
    SB["Sandbox Task B<br/>Producer · Status-Pool · Consumer"]

    OA[("Ordner A<br/>inbox → pendingbox →<br/>donebox / errorbox")]
    OB[("Ordner B<br/>inbox → pendingbox →<br/>donebox / errorbox")]

    Cloud["Cloud-Dienst<br/>API 1: BatchgenAuftrag anlegen (einmal je Task),<br/>Batches übernehmen<br/>API 2: Status der Datensätze<br/>API 3: Endzustand setzen, Status abfragen"]

    UserA --> API
    UserB --> API
    API --> TM
    TM -->|"laufend"| Reg
    TM -->|"starten / abbrechen"| SA
    TM -->|"starten / abbrechen"| SB
    SA <-->|"Dateien"| OA
    SB <-->|"Dateien"| OB
    SA ==>|"API 1 + 2"| Cloud
    SB ==>|"API 1 + 2"| Cloud
    TM ==>|"API 1: anlegen<br/>API 3: Endzustand, Status"| Cloud

