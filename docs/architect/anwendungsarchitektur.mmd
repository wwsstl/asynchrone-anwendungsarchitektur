flowchart LR

    %% Funktionsweise (Überblick, Stand erste_phase_zusatz_anforderungen.md)
    %% Phase 1: eine Instanz; Aufgabennummer = BatchgenAuftrag-Nr.; kein Fortsetzen abgebrochener Tasks

    API["REST-API (WebFlux)<br/>Start / Abbruch / Status"] -->|"Start, Abbruch"| TM["TaskManager"]
    API ==>|"Status: Zustand, Summen<br/>der Datensätze, lastSeen"| API3
    TM -->|"baut auf, startet,<br/>Abbruchsignal (nur lokal)"| Sandbox
    TM -->|"laufende Sandboxen"| Reg[("TaskRegistry<br/>(lokal)")]
    TM -.->|"Startprüfung:<br/>leer?"| Pending
    TM ==>|"BatchgenAuftrag anlegen<br/>(abgelehnt bei RUNNING / CANCELED)"| API1
    TM ==>|"bedingt setzen: COMPLETED /<br/>CANCELED (Fehlerschwelle) / ERROR (Timeout)"| API3["Cloud-API 3<br/>BatchgenAuftrag"]

    subgraph Sandbox["Sandbox je Task"]
        P["Producer<br/>(Virtual Thread)"] -->|"TaskIds"| Pool[("Status-Pool")]
        Pool --> C["Consumer<br/>(Virtual Thread)"]
        Pool -.->|"Rückstau:<br/>pool-resume-threshold"| P
    end

    Inbox[("inbox")] -->|"Batch lesen"| P
    P -->|"beanspruchen,<br/>TaskId-Marker"| Pending[("pendingbox")]
    P ==>|"Batch + BatchgenAuftrag-Nr.<br/>als eine JSON-Anfrage"| API1["Cloud-API 1<br/>BatchgenAuftrag anlegen,<br/>Batches übernehmen"]
    API1 -.->|"TaskId je umgewandelter Datei,<br/>nicht umgewandelte Dateien"| P
    C ==>|"Bulk-Abfrage als eine Anfrage"| API2["Cloud-API 2<br/>Status der Datensätze"]
    C ==>|"lastSeen je Durchlauf"| API3
    C -->|"SUCCESS"| Done[("donebox")]
    C -->|"ERROR / Timeout"| Error[("errorbox")]
    P -->|"nicht umgewandelt"| Error
    Sandbox -.->|"Threads beendet:<br/>Abmeldung"| TM

    Pending -.->|"Reste nach Abbruch,<br/>Fehlerschwelle, Absturz"| Clean["CleanMassenanlageAuftrag<br/>(eigenständiges Programm)"]
    Clean ==>|"lastSeen abgelaufen?<br/>danach ERROR setzen"| API3
    Clean ==>|"aktueller Status der Reste"| API2
    Clean -->|"Reste verteilen"| Done
    Clean --> Error

    classDef thread fill:#e8f0fe,stroke:#4472c4,stroke-width:1px;
    classDef store fill:#fef6e0,stroke:#c99a2e,stroke-width:1px;
    classDef external fill:#eaf7ea,stroke:#3c8a3c,stroke-width:1px;
    classDef program fill:#f3e8fd,stroke:#8e44ad,stroke-width:1px;

    class P,C thread;
    class Pool,Reg,Inbox,Pending,Done,Error store;
    class API1,API2,API3 external;
    class Clean program;
