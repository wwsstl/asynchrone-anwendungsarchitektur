flowchart LR

    %% Funktionsweise (Überblick, Stand funktionsweise_sequenz.md)
    %% Aufgabennummer = Nr. des BatchgenAuftrags, kein Fortsetzen abgebrochener Aufgaben

    API["REST-API (WebFlux)<br/>Start / Abbruch / Status"] --> TM["TaskManager"]
    TM -->|"baut auf, startet,<br/>Abbruchsignal"| Sandbox
    TM -->|"laufende Tasks,<br/>lokaler Stand"| Reg[("TaskRegistry")]
    TM -.->|"Start: leer?"| Pending
    TM ==>|"Start: BatchgenAuftrag anlegen"| API1
    TM ==>|"Endzustand setzen: COMPLETED / TIMEOUT /<br/>ERROR / TERMINATED, Status abfragen"| API3["Cloud-API 3<br/>BatchgenAuftrag"]

    subgraph Sandbox["Sandbox je Task"]
        P["Producer<br/>(Virtual Thread)"] -->|"TaskIds"| Pool[("Status-Pool")]
        Pool --> C["Consumer<br/>(Virtual Thread)"]
        Pool -.->|"Rückstau:<br/>pool-resume-threshold"| P
    end

    Inbox[("inbox")] -->|"Batch lesen"| P
    P -->|"vor dem Aufruf verschieben,<br/>TaskId-Marker"| Pending[("pendingbox")]
    P -.->|"eindeutig nicht verarbeitet:<br/>zurück, später erneut"| Inbox
    P ==>|"Batch + Aufgabennummer<br/>als eine JSON-Anfrage"| API1["Cloud-API 1<br/>BatchgenAuftrag anlegen,<br/>Batches übernehmen"]
    API1 -.->|"TaskId je umgewandelter Datei,<br/>nicht umgewandelte Dateien"| P
    C ==>|"Bulk-Abfrage als eine Anfrage"| API2["Cloud-API 2<br/>Status der Datensätze"]
    C -->|"SUCCESS"| Done[("donebox")]
    C -->|"ERROR"| Error[("errorbox")]
    P -->|"nicht umgewandelt"| Error
    Sandbox -.->|"Threads beendet:<br/>Abmeldung"| TM

    classDef thread fill:#e8f0fe,stroke:#4472c4,stroke-width:1px;
    classDef store fill:#fef6e0,stroke:#c99a2e,stroke-width:1px;
    classDef external fill:#eaf7ea,stroke:#3c8a3c,stroke-width:1px;

    class P,C thread;
    class Pool,Reg,Inbox,Pending,Done,Error store;
    class API1,API2,API3 external;
