flowchart TB

    subgraph Extern["Externe Steuerungsebene"]
        UserA["Benutzer A"]
        UserB["Benutzer B / Überwachungssystem"]
    end

    subgraph App["Spring Boot Anwendung — Einzelserver (Java 21, Spring Boot 4, Spring WebFlux/Netty, Jackson 3)"]
        API["REST-Controller (Spring WebFlux)<br/>Start / Abbruch / Status<br/>liefert Mono"]
        Sched["taskManagerScheduler<br/>je Anfrage ein Virtual Thread<br/>(kein Blockieren des Event-Loops)"]
        TM["Task Manager<br/>baut Sandbox je Benutzer auf,<br/>Startsperre je Benutzer,<br/>meldet beendete Tasks ab"]
        Reg[("TaskRegistry<br/>laufende Sandboxen<br/>ConcurrentHashMap")]
        Hist[("TaskHistory<br/>Endzustände beendeter Tasks<br/>abfragbar für task-retention (24 h)")]

        subgraph SandboxA["Sandbox Benutzer A (laufzeit-dynamisch, isoliert)"]
            CtxA[("TaskContext A<br/>Zustand, Abbruchsignal<br/>Zähler, Start-/Endzeit, Timeout")]
            PoolA[("Status-Pool A<br/>ConcurrentHashMap<br/>TaskId → PollEntry")]
            ProdA["Producer-Thread A<br/>(Virtual Thread)<br/>Wiederaufnahme → Batch beanspruchen → Submit"]
            ConsA["Consumer-Thread A<br/>(Virtual Thread)<br/>periodischer Sweep → Bulk-Status → Routing"]
        end

        subgraph SandboxB["Sandbox Benutzer B (laufzeit-dynamisch, isoliert)"]
            NoteB["Strukturell identisch zu Sandbox A:<br/>eigener TaskContext, eigener Status-Pool,<br/>eigener Producer- &amp; Consumer-Thread,<br/>eigene Ordner — vollständig unabhängig von Sandbox A"]
        end
    end

    subgraph Cloud["Cloud-Dienste"]
        CloudSubmit["Cloud-API 1<br/>Erstellungsauftrag übermitteln<br/>(nicht idempotent)"]
        CloudQuery["Cloud-API 2<br/>Bulk-Statusabfrage (mehrere TaskIds)"]
    end

    subgraph FilesA["Exklusiver lokaler Ordner Benutzer A"]
        InboxA[("inbox (A)")]
        PendingA[("pendingbox (A)<br/>+ .taskids: TaskId je Datei")]
        DoneA[("donebox (A)")]
        ErrorA[("errorbox (A)")]
    end

    UserA -->|"Aufgabe A starten / abbrechen / Status"| API
    UserB -->|"Aufgabe B starten / abbrechen / Status"| API

    API -->|"blockierende Aufrufe auslagern"| Sched
    Sched --> TM
    TM -->|"Sandbox eintragen (Start),<br/>entfernen (Abbruch / Abmeldung)"| Reg
    TM -->|"Endzustand ablegen (Abmeldung),<br/>abgelaufene entfernen"| Hist

    TM -->|"1. initialisieren"| CtxA
    TM -->|"2. anlegen"| PoolA
    TM -->|"3. starten"| ProdA
    TM -->|"4. starten"| ConsA

    ProdA -->|"Batch lesen (Vorabprüfung Abbruchsignal)"| InboxA
    ProdA -->|"vor Übermittlung verschieben, danach TaskId-Marker schreiben;<br/>beim Start markierte Dateien wiederaufnehmen"| PendingA
    ProdA ==>|"nicht-blockierend, Batch"| CloudSubmit
    CloudSubmit -.->|"TaskId je Datei"| ProdA
    ProdA -->|"TaskId einfügen"| PoolA
    PoolA -.->|"Rückstau: nächster Batch erst bei<br/>Poolgröße ≤ pool-resume-threshold"| ProdA

    ConsA -->|"fällige Einträge sammeln"| PoolA
    ConsA ==>|"Bulk-Aufruf: alle fälligen TaskIds"| CloudQuery
    CloudQuery -.->|"SUCCESS / ERROR / PENDING je TaskId"| ConsA

    ConsA -->|"SUCCESS: verschieben, Marker löschen"| DoneA
    ConsA -->|"ERROR / Timeout: verschieben, Marker löschen"| ErrorA
    ConsA -.->|"PENDING: Eintrag im Pool belassen"| PoolA
    ConsA -.->|"errorCount++ / Timeout prüfen / abschließen"| CtxA

    ProdA -.->|"Thread-Ende"| TM
    ConsA -.->|"Thread-Ende: der zuletzt<br/>endende Thread meldet den Task ab"| TM

    classDef thread fill:#e8f0fe,stroke:#4472c4,stroke-width:1px;
    classDef store fill:#fef6e0,stroke:#c99a2e,stroke-width:1px;
    classDef external fill:#eaf7ea,stroke:#3c8a3c,stroke-width:1px;
    classDef note fill:#f5f5f5,stroke:#999999,stroke-dasharray: 4 3;

    class ProdA,ConsA,Sched thread;
    class Reg,Hist,CtxA,PoolA,InboxA,PendingA,DoneA,ErrorA store;
    class CloudSubmit,CloudQuery external;
    class NoteB note;
